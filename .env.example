# Copy to .env and adjust. Never commit the real .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Development: True. Production: False.
DEBUG=True

# Comma-separated hostnames (production).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated https origins for CSRF (production), e.g. https://shop.example.com
CSRF_TRUSTED_ORIGINS=

# Leave blank to use SQLite. For Postgres:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

TIME_ZONE=UTC

# Force HTTPS redirects when DEBUG is off (set False if your proxy already does it).
SECURE_SSL_REDIRECT=True
